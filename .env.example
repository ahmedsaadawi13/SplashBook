# FILE: /.env.example
# SplashBook Environment Configuration
# Copy this file to .env and update with your settings

# Application
APP_NAME=SplashBook
APP_ENV=development
APP_URL=http://localhost
APP_TIMEZONE=UTC

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=splashbook
DB_USERNAME=root
DB_PASSWORD=

# Session
SESSION_LIFETIME=7200

# File Upload
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx

# Email (for future SMTP integration)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@splashbook.example
MAIL_FROM_NAME=SplashBook

# Security
REQUIRE_HTTPS=false
